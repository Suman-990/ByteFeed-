# Database — use your Neon/Postgres connection string
DB_URL=

# JWT — change this to a strong random secret in production
JWT_SECRET=change-me-in-production

# Cloudinary — get these from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port (optional, defaults to 8080)
PORT=8080

# LiveKit — get these from livekit.io cloud dashboard
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_HOST=wss://your-project.livekit.cloud
